    "jwt-decode": "^4.0.0",
    "pinia": "^3.0.4",
    "sass": "^1.106.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rushstack/eslint-patch": "^1.16.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
